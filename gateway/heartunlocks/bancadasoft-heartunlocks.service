[Unit]
Description=BancadaSoft HeartUnlocks Gateway
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bancadasoft-heartunlocks
EnvironmentFile=/etc/bancadasoft/heartunlocks.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
User=bancadasoft
Group=bancadasoft
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
