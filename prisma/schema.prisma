generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  REVIEWED
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum ProductType {
  TOOL
  RENTAL
  ACTIVATION
  LICENSE
  REMOTE_SERVICE
  CREDIT
  IMEI_SN
  FILE
}

enum DeliveryType {
  IMMEDIATE
  AUTOMATIC
  MANUAL
  ON_REQUEST
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  FULFILLED
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  QUEUED
  PROCESSING
  FULFILLED
  FAILED
}

enum ProviderIntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

enum ProviderOrderStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProviderMode {
  TEST
  REAL
}

enum AutomationClass {
  AUTO_CREDENTIAL
  AUTO_GENERIC_REPLAY
  AUTO_FIELD_BASED
  REMOTE_SESSION
  MANUAL_REVIEW
  UNSUPPORTED
}

enum TechnicalEligibility {
  READY
  REVIEW
  UNSUPPORTED
}

enum HomologationStatus {
  UNTESTED
  CLASS_VALIDATED
  PRODUCT_VALIDATED
  FAILED
}

enum ProviderDeliveryType {
  CREDENTIALS
  LICENSE
  CODE
  TEXT
  MULTI_FIELD
}

enum DeliveryNotificationStatus {
  PENDING
  SENT
  FAILED
  NOT_CONFIGURED
}

enum PricingMode {
  AUTO_GLOBAL
  AUTO_GROUP
  MANUAL
}

enum PricingStatus {
  AUTO_OK
  MANUAL
  NEEDS_REVIEW
  NO_COST
  INVALID_CONFIG
}

enum PricingFeeType {
  FIXED
  PERCENTAGE
  COMBINED
}

enum PricingRoundingMode {
  NONE
  X_90
  X_99
  NEAREST_1
  NEAREST_5
}

enum CustomerTier {
  NORMAL
  PREMIUM
}

enum PriceVisibility {
  PUBLIC
  LOGIN_REQUIRED
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  role            String       @default("CUSTOMER")
  customerTier    CustomerTier @default(NORMAL)
  passwordHash    String
  asaasCustomerId String?      @unique
  cpfCnpj         String?
  whatsapp        String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  orders          Order[]
  auditLogs       AuditLog[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  products  Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  imageUrl  String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                  String            @id @default(cuid())
  slug                String            @unique
  name                String
  description         String
  longDescription     String?
  type                ProductType
  deliveryType        DeliveryType      @default(AUTOMATIC)
  deliveryEstimate    String?
  searchTerms         String            @default("")
  duration            String?
  imageUrl            String?
  downloadUrl         String?
  downloadLabel       String?
  priceCents          Int
  priceVisibility     PriceVisibility   @default(PUBLIC)
  normalPriceCents    Int?
  premiumPriceCents   Int?
  costCents           Int?
  pricingMode         PricingMode       @default(MANUAL)
  manualPriceCents    Int?
  suggestedPriceCents Int?
  pricingStatus       PricingStatus     @default(MANUAL)
  pricingComputedAt   DateTime?
  featured            Boolean           @default(false)
  sortOrder           Int               @default(0)
  status              ProductStatus     @default(DRAFT)
  available           Boolean           @default(true)
  categoryId          String
  category            Category          @relation(fields: [categoryId], references: [id])
  brandId             String?
  brand               Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  orderItems          OrderItem[]
  providerProducts    ProviderProduct[]
  variants            ProductVariant[]

  @@index([status, available, sortOrder])
  @@index([categoryId, status])
  @@index([brandId, status])
}

model PricingConfiguration {
  id                 String              @id @default("default")
  automaticEnabled   Boolean             @default(false)
  exchangeRateMicros Int?
  exchangeBufferBps  Int                 @default(0)
  targetMarginBps    Int                 @default(0)
  minimumProfitCents Int                 @default(0)
  asaasFeeType       PricingFeeType      @default(FIXED)
  asaasFixedFeeCents Int                 @default(0)
  asaasPercentBps    Int                 @default(0)
  roundingMode       PricingRoundingMode @default(NONE)
  minimumPriceCents  Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  groupRules         PricingGroupRule[]
}

model PricingGroupRule {
  id                 String               @id @default(cuid())
  configurationId    String               @default("default")
  configuration      PricingConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  productType        ProductType
  exchangeBufferBps  Int?
  targetMarginBps    Int?
  minimumProfitCents Int?
  minimumPriceCents  Int?
  roundingMode       PricingRoundingMode?
  additionalFeeCents Int?
  additionalFeeBps   Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([configurationId, productType])
  @@index([productType])
}

model SiteSettings {
  id                 String       @id @default("default")
  businessName       String       @default("BANCADASOFT")
  slogan             String       @default("Encontrou. Pagou. Liberou.")
  domain             String       @default("bancadasoft.com.br")
  supportWhatsapp    String?
  supportEmail       String?
  supportText        String?
  maintenanceEnabled Boolean      @default(false)
  maintenanceMessage String       @default("Estamos realizando melhorias. Voltaremos em breve.")
  providerMode       ProviderMode @default(TEST)
  updatedAt          DateTime     @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Order {
  id                     String                  @id @default(cuid())
  publicToken            String                  @unique
  status                 OrderStatus             @default(PENDING_PAYMENT)
  customerId             String
  customer               User                    @relation(fields: [customerId], references: [id])
  totalCents             Int
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  items                  OrderItem[]
  payment                Payment?
  fulfillment            Fulfillment?
  events                 OrderEvent[]
  providerOrders         ProviderOrder[]
  deliveryTokenHash      String?                 @unique
  deliveryTokenExpiresAt DateTime?
  deliveryTokenRevokedAt DateTime?
  deliveryTokenEncrypted String?
  deliveryNotifiedAt     DateTime?
  deliveryAccessAttempts DeliveryAccessAttempt[]
  deliveryNotifications  DeliveryNotification[]
}

model DeliveryNotification {
  id                String                     @id @default(cuid())
  orderId           String
  order             Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel           String                     @default("EMAIL")
  status            DeliveryNotificationStatus @default(PENDING)
  provider          String                     @default("resend")
  recipientMasked   String
  providerMessageId String?
  attempts          Int                        @default(0)
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  errorMessage      String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([orderId, channel])
  @@index([status, createdAt])
}

model DeliveryAccessAttempt {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fingerprint String
  successful  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([orderId, fingerprint, createdAt])
}

model OrderItem {
  id                String           @id @default(cuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  unitPriceCents    Int
  providerFields    Json?
  productVariantId  String?
  productVariant    ProductVariant?  @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  providerProductId String?
  providerProduct   ProviderProduct? @relation("PurchasedProviderProduct", fields: [providerProductId], references: [id], onDelete: Restrict)

  @@index([productVariantId])
  @@index([providerProductId])
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String         @unique
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  status            PaymentStatus  @default(PENDING)
  providerReference String         @unique
  externalPaymentId String?        @unique
  amountCents       Int
  pixCode           String
  qrCode            String?
  expiresAt         DateTime
  createdAt         DateTime       @default(now())
  events            PaymentEvent[]
}

model PaymentEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  payload         Json
  createdAt       DateTime @default(now())
}

model Fulfillment {
  id             String            @id @default(cuid())
  orderId        String            @unique
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String
  status         FulfillmentStatus @default(QUEUED)
  delivery       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  providerOrders ProviderOrder[]
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String
  createdAt DateTime    @default(now())
}

model Provider {
  id                String                    @id @default(cuid())
  name              String
  code              String                    @unique
  active            Boolean                   @default(false)
  apiBaseUrl        String?
  integrationStatus ProviderIntegrationStatus @default(NOT_CONNECTED)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  products          ProviderProduct[]
  orders            ProviderOrder[]
}

model ProviderProduct {
  id                   String               @id @default(cuid())
  providerId           String
  provider             Provider             @relation(fields: [providerId], references: [id], onDelete: Restrict)
  productId            String?
  product              Product?             @relation(fields: [productId], references: [id], onDelete: Restrict)
  externalProductId    String
  label                String?
  providerCostCents    Int?
  currency             String               @default("BRL")
  active               Boolean              @default(true)
  mode                 ProviderMode         @default(REAL)
  metadata             Json?
  lastSyncedAt         DateTime?
  syncStatus           String?
  automationClass      AutomationClass      @default(MANUAL_REVIEW)
  technicalEligibility TechnicalEligibility @default(REVIEW)
  homologationStatus   HomologationStatus   @default(UNTESTED)
  contractSignature    String?
  fieldSchema          Json?
  expectedDeliveryType ProviderDeliveryType @default(TEXT)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  orders               ProviderOrder[]
  variants             ProductVariant[]
  purchasedItems       OrderItem[]          @relation("PurchasedProviderProduct")

  @@unique([providerId, externalProductId])
  @@index([productId, active])
  @@index([providerId, automationClass, technicalEligibility])
  @@index([contractSignature])
}

model ProductVariant {
  id                  String          @id @default(cuid())
  productId           String
  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  providerProductId   String          @unique
  providerProduct     ProviderProduct @relation(fields: [providerProductId], references: [id], onDelete: Restrict)
  name                String
  code                String
  active              Boolean         @default(true)
  sortOrder           Int             @default(0)
  priceCents          Int?
  normalPriceCents    Int?
  premiumPriceCents   Int?
  pricingMode         PricingMode     @default(AUTO_GLOBAL)
  manualPriceCents    Int?
  suggestedPriceCents Int?
  pricingStatus       PricingStatus   @default(INVALID_CONFIG)
  pricingComputedAt   DateTime?
  publicationBlocked  Boolean         @default(false)
  holdReason          String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  orderItems          OrderItem[]

  @@unique([productId, code])
  @@index([productId, active, sortOrder])
}

model ProviderOrder {
  id                String                  @id @default(cuid())
  providerId        String
  provider          Provider                @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerProductId String?
  providerProduct   ProviderProduct?        @relation(fields: [providerProductId], references: [id], onDelete: Restrict)
  orderId           String
  order             Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillmentId     String                  @unique
  fulfillment       Fulfillment             @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  externalOrderId   String?
  status            ProviderOrderStatus     @default(QUEUED)
  costCents         Int?
  currency          String                  @default("BRL")
  attempts          Int                     @default(0)
  lastError         String?
  requestReference  String?
  responseReference String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  callbackEvents    ProviderCallbackEvent[]

  @@index([orderId, status])
  @@index([providerId, externalOrderId])
}

model ProviderCallbackEvent {
  id              String        @id @default(cuid())
  providerOrderId String
  providerOrder   ProviderOrder @relation(fields: [providerOrderId], references: [id], onDelete: Cascade)
  eventKey        String        @unique
  status          String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([providerOrderId, createdAt])
}

model HomeBanner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}
